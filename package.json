{
  "name": "nftgen-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 7103",
    "dev": "vite --host 0.0.0.0 --port 7103",
    "dev:network": "vite --host 0.0.0.0 --port 7103",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0 --port 7103",
    "api": "cd api && node server.js",
    "websocket": "node server/websocket.js --port 7101",
    "check": "npm outdated && npm audit",
    "network:check": "node check-network.mjs",
    "network:restart": "bash restart-server.sh",
    "start:all": "../ecosystem-check.sh",
    "deploy-contract": "hardhat run scripts/deploy.cjs --config hardhat.config.cjs --network sepolia",
    "compile-contract": "hardhat compile --config hardhat.config.cjs",
    "prepare-nwallet-deploy": "node scripts/deploy-with-nwallet.js",
    "deploy-fractional": "hardhat run scripts/deploy-fractional.js --config hardhat.config.cjs --network sepolia",
    "verify-integration": "node verify-integration.js",
    "fix-modules": "chmod +x fix-all-modules.sh && ./fix-all-modules.sh",
    "restart-all": "cd .. && pm2 restart nwallet-ws nwallet-api nwallet-frontend nftgen-frontend nftgen-api nftgen-websocket",
    "troubleshoot": "echo 'Running all troubleshooting steps...' && npm run fix-modules && npm run build && npm run restart-all && npm run verify-integration",
    "setup": "chmod +x setup-and-verify.sh && ./setup-and-verify.sh",
    "deploy": "chmod +x deploy.sh && ./deploy.sh",
    "test": "vitest",
    "test:performance": "vitest src/tests/performance.test.ts",
    "test:components": "vitest src/tests/components/",
    "test:e2e": "vitest src/tests/e2e/",
    "test:all": "tsx src/tests/run-performance-tests.ts",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@apollo/client": "^3.13.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@headlessui/react": "^2.2.2",
    "@heroicons/react": "^2.1.1",
    "@mui/icons-material": "^6.4.11",
    "@mui/material": "^6.4.7",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@openzeppelin/contracts": "^5.4.0",
    "@tanstack/react-query": "^5.67.1",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "alchemy-sdk": "^3.5.8",
    "any-signal": "^4.1.1",
    "axios": "^1.11.0",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "graphql": "^16.8.1",
    "lucide-react": "^0.344.0",
    "mongodb": "^6.16.0",
    "nft.storage": "^7.2.0",
    "pinata": "^2.4.9",
    "puppeteer": "^24.8.1",
    "react": "^18.2.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-error-boundary": "^5.0.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^6.22.2",
    "react-toastify": "^11.0.5",
    "varint": "^6.0.0",
    "viem": "1.21.4",
    "wagmi": "^1.4.13",
    "ws": "^8.18.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-toastify": "^4.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "assert": "^2.1.0",
    "autoprefixer": "^10.4.18",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "hardhat": "^2.22.19",
    "https-browserify": "^1.0.0",
    "jsdom": "^24.1.3",
    "os-browserify": "^0.3.0",
    "postcss": "^8.4.35",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "url": "^0.11.4",
    "vite": "^5.4.2",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^1.6.1"
  }
}
