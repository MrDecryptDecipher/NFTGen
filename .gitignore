# Final overrides to ensure node_modules are NEVER tracked even if inside whitelisted dirs
**/node_modules/


# Root level config whitelists
!vite.config.js
!vite.config.ts
!hardhat.config.js
!hardhat.config.cjs
!postcss.config.js
!tailwind.config.js
!eslint.config.js
!ecosystem.config.cjs
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.*.json
!vercel.json
!.gitignore
!.env.example
!README.md
!LICENSE
!CHANGELOG.md

# Explicitly ignore known junk in whitelisted dirs if necessary
