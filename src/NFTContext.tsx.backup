import React, { useState, useEffect, useContext, createContext, ReactNode } from 'react';
import { toast } from 'react-toastify';
import { useWeb3React } from '@web3-react/core';
import { ipfsClient } from './config/ipfsClient';
import * as ipfsAdapter from './utils/ipfs-adapter'; // Add import for ipfs-adapter

// Find the uploadToIPFS function and replace it to use our adapter
const uploadToIPFS = async (file: File) => {
  try {
    console.log("Attempting IPFS file upload using adapter:", file.name);
    const url = await ipfsAdapter.uploadFileToIPFS(file);
    console.log("IPFS upload successful, URL:", url);
    return url;
  } catch (error) {
    console.error("IPFS file upload failed:", error);
    throw error;
  }
};

// Replace the uploadMetadataToIPFS function as well if it exists
const uploadMetadataToIPFS = async (metadata: any) => {
  try {
    console.log("Uploading metadata to IPFS:", metadata.name);
    const url = await ipfsAdapter.uploadMetadataToIPFS(metadata);
    console.log("Metadata upload successful, URL:", url);
    return url;
  } catch (error) {
    console.error("Metadata upload failed:", error);
    throw error;
  }
};

