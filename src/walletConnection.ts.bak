import { toast } from 'react-toastify';
import type {
  NijaWalletProvider,
  WalletEventType,
  WalletEvent,
  WalletMessage,
  TransactionParams,
  TransactionResponse,
  AccountsChangedCallback,
  ChainChangedCallback,
